# Server-only loyalty configuration. Never expose the service role key in a
# NEXT_PUBLIC variable or commit real values to git.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Use a strong staff password and a separate random secret of at least 32 characters.
LOYALTY_STAFF_PASSWORD=replace-with-a-strong-password
LOYALTY_SESSION_SECRET=replace-with-a-long-random-secret

# Optional Google Wallet support. Create an issuer account and an approved
# Loyalty Class first, then add its issuer ID and class suffix here.
GOOGLE_WALLET_ISSUER_ID=your-numeric-issuer-id
GOOGLE_WALLET_CLASS_SUFFIX=twenty_second_rewards
GOOGLE_WALLET_SERVICE_ACCOUNT_EMAIL=wallet-service-account@your-project.iam.gserviceaccount.com
GOOGLE_WALLET_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-with-your-private-key\n-----END PRIVATE KEY-----\n"

# Contact form delivery. Verify the sending domain in Resend before using it.
# CONTACT_TO_EMAIL must be an inbox approved by the cafe owner. These values
# are server-only and must never use a NEXT_PUBLIC_ prefix.
RESEND_API_KEY=re_replace-with-a-server-api-key
CONTACT_FROM_EMAIL="twenty second coffee website <website@your-verified-domain.example>"
CONTACT_TO_EMAIL=approved-cafe-inbox@example.com

# Distributed contact-form rate limiting. Create an Upstash Redis database and
# use a separate random secret of at least 32 characters to pseudonymise IPs.
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-your-rest-token
CONTACT_RATE_LIMIT_SECRET=replace-with-a-random-secret-at-least-32-characters
