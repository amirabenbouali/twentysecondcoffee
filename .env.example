# Server-only loyalty configuration. Never expose the service role key in a
# NEXT_PUBLIC variable or commit real values to git.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Use a strong staff password and a separate random secret of at least 32 characters.
LOYALTY_STAFF_PASSWORD=replace-with-a-strong-password
LOYALTY_SESSION_SECRET=replace-with-a-long-random-secret

# Optional Google Wallet support. Create an issuer account and an approved
# Loyalty Class first, then add its issuer ID and class suffix here.
GOOGLE_WALLET_ISSUER_ID=your-numeric-issuer-id
GOOGLE_WALLET_CLASS_SUFFIX=twenty_second_rewards
GOOGLE_WALLET_SERVICE_ACCOUNT_EMAIL=wallet-service-account@your-project.iam.gserviceaccount.com
GOOGLE_WALLET_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-with-your-private-key\n-----END PRIVATE KEY-----\n"
